# Authentication for SQL users. Included from 10-auth.conf.
#
# <doc/wiki/AuthDatabase.SQL.txt>

passdb sql {  
  query = SELECT username AS user,password FROM mailbox WHERE username = '%{user}' AND active=1
}

# "prefetch" user database means that the passdb already provided the
# needed information and there's no need to do a separate userdb lookup.
# <doc/wiki/UserDatabase.Prefetch.txt>
#userdb {
#  driver = prefetch
#}

userdb sql {
  query = SELECT username as user, CONCAT('/var/vmail/', maildir) AS home, 1000 AS uid, 1000 AS gid, CONCAT('*:bytes=', quota) AS quota_rule, 1 AS priority FROM mailbox WHERE username = '%{user}' AND active = 1
  #query = \
    #(SELECT username as user, CONCAT('/var/vmail/', maildir) AS home, 1000 AS uid, 1000 AS gid, CONCAT('*:bytes=', quota) AS quota_rule, 1 AS priority \
    # FROM mailbox \
    # WHERE username = '%{user}') \
    #UNION \  
    #(SELECT username as user, CONCAT('/var/vmail/', m.maildir) AS home, 1000 AS uid, 1000 AS gid, CONCAT('*:bytes=', m.quota) AS quota_rule, 2 AS priority \
    # FROM mailbox m \
    # JOIN alias a ON m.username = a.goto \
    # WHERE a.address = '%{user}') \
    #UNION \  
    #(SELECT username as user, CONCAT('/var/vmail/', m.maildir) AS home, 1000 AS uid, 1000 AS gid, CONCAT('*:bytes=', m.quota) AS quota_rule, 3 AS priority \
    # FROM mailbox m \
    # JOIN alias a ON m.username = a.goto \
    # WHERE a.address = CONCAT('@', '%{user | domain}')) \
    #ORDER BY priority ASC \
    #LIMIT 1
  iterate_query = SELECT username AS user FROM mailbox WHERE active=1
}


# If you don't have any user-specific settings, you can avoid the user_query
# by using userdb static instead of userdb sql, for example:
# <doc/wiki/UserDatabase.Static.txt>
#userdb {
  #driver = static
  #args = uid=vmail gid=vmail home=/var/vmail/%u
#}
